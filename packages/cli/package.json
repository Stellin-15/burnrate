{
  "name": "burnrate-cli",
  "version": "0.4.0",
  "description": "See how much of your Claude usage limit is left and what it costs: a live meter for Claude Code, a local dashboard, and cost reports. Local-first.",
  "keywords": [
    "claude-code",
    "statusline",
    "ai",
    "usage",
    "cost",
    "tokens",
    "anthropic"
  ],
  "homepage": "https://github.com/Stellin-15/burnrate#readme",
  "bugs": {
    "url": "https://github.com/Stellin-15/burnrate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stellin-15/burnrate.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Stellin",
  "type": "module",
  "bin": {
    "burnrate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-dashboard.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  },
  "devDependencies": {
    "@burnrate/adapter-claude-code": "workspace:*",
    "@burnrate/core": "workspace:*",
    "@burnrate/dashboard": "workspace:*",
    "@burnrate/pricing": "workspace:*",
    "@burnrate/store": "workspace:*",
    "@burnrate/adapter-anthropic-api": "workspace:*",
    "@burnrate/adapter-openai-api": "workspace:*"
  }
}
